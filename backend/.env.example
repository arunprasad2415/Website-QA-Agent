PORT=4000

# Optional server keys. Leave empty to allow that provider only via BYOK.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DEFAULT_PROVIDER=claude
CLAUDE_DEFAULT_MODEL=claude-opus-5-5
# Required for ChatGPT unless each request sends "model": must support images + function calling
OPENAI_DEFAULT_MODEL=

MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_MS=300000
# Only set true for local testing: lets the agent open localhost / private IPs
ALLOW_PRIVATE_URLS=false
# Set false to watch the browser while debugging
HEADLESS=true
